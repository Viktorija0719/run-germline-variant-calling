// Site-local reference genome(s) not covered by the vendored igenomes.config.
//
// GRCh38.no_alt_analysis_set was pulled from dx_downloads/ref/ to replace the
// GATK bundle reference (Homo_sapiens_assembly38.fasta), which carries hs38d1
// decoy contigs (e.g. chrUn_KN707893v1_decoy) that our BAMs don't have,
// causing Strelka's reference/BAM contig-mismatch error.
//
// One-time prep required on the HPC before this resolves (see run_germline/README.md).
// Named .fasta (not .fa) on purpose: VERIFYBAMID_VERIFYBAMID2's module only
// passes --Reference when the staged filename ends in ".fasta", and the .fai
// must share the fasta's exact basename for htslib/GATK auto-discovery to work.
//   cd /home_beegfs/vikja01/dx_downloads/ref
//   gunzip -c GRCh38.no_alt_analysis_set.fa.gz > GRCh38.no_alt_analysis_set.fasta
//   cp GRCh38.no_alt_analysis_set.fa.fai GRCh38.no_alt_analysis_set.fasta.fai
//   gatk CreateSequenceDictionary -R GRCh38.no_alt_analysis_set.fasta -O GRCh38.no_alt_analysis_set.dict
//   mkdir -p GRCh38.no_alt_analysis_set.bwa-index
//   tar -xzf GRCh38.no_alt_analysis_set.bwa-index.tar.gz -C GRCh38.no_alt_analysis_set.bwa-index

params {
  ref_no_alt_base = "/home_beegfs/vikja01/dx_downloads/ref"

  genomes {
    'RSU.GRCh38_no_alt' {
      fasta     = "${params.ref_no_alt_base}/GRCh38.no_alt_analysis_set.fasta"
      fasta_fai = "${params.ref_no_alt_base}/GRCh38.no_alt_analysis_set.fasta.fai"
      dict      = "${params.ref_no_alt_base}/GRCh38.no_alt_analysis_set.dict"
      bwa       = "${params.ref_no_alt_base}/GRCh38.no_alt_analysis_set.bwa-index/"
    }
  }
}
