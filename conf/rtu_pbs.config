process {
  executor = 'pbs'
  queue    = 'long'

  /*
   * Critical on many PBS/Torque systems:
   * export the environment from the submitting job (PATH, NXF_* vars, etc.)
   */
  clusterOptions = '-V'

  /*
   * Ensure the 'module' command exists and Singularity is loaded on the compute node.
   */
  beforeScript = '''
    source /etc/profile || true
    source /etc/profile.d/modules.sh || true
    source /etc/profile.d/lmod.sh || true
    module load singularity || true
  '''

  withName: /.*SNPSIFT_ANNMEM.*/ {
    beforeScript = '''
      source /etc/profile || true
      source /etc/profile.d/modules.sh || true
      source /etc/profile.d/lmod.sh || true
      module load singularity || true
      export JAVA_TOOL_OPTIONS='-XX:-UsePerfData'
    '''
    errorStrategy = 'retry'
    maxRetries = 1
  }

  // GenomicsDBImport is labelled process_single (8 GB) upstream, which is
  // far too little for a WES cohort.
  withName: /.*GATK4_GENOMICSDBIMPORT.*/ {
    cpus    = 4
    memory  = 64.GB
    scratch = '/tmp'
    errorStrategy = 'retry'
    maxRetries    = 1
  }

  // GenotypeGVCFs traverses the WES BED intervals across 5 samples.
  // process_single gives 8 GB / ~6.5 GB Java heap — too little and causes
  // PBS OOM kill (exit 247). 32 GB keeps it well within the node's budget.
  withName: /.*GATK4_GENOTYPEGVCFS.*/ {
    cpus   = 4
    memory = 32.GB
    time   = '24h'
  }

}

executor {
  queueSize = 50
}

singularity {
  enabled    = true
  autoMounts = true
  // cacheDir can be set here too, but exporting NXF_SINGULARITY_CACHEDIR via -V is enough
}
